{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "declaration": false,
    "noEmit": true
  },
  "include": ["db", "repo", "commands", "queries", "lib", "server", "test", "e2e", "playwright.config.ts"],
  "exclude": ["web"]
}
